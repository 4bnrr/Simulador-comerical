{
  "name": "simulador-comercial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:server && node dist-server/server.js",
    "build": "next build --webpack && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json && node -e \"require('node:fs').writeFileSync('dist-server/package.json', JSON.stringify({type:'module'}))\"",
    "start": "node dist-server/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-tests/features/payment-plan/calculator.test.js",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
